{
  "expo": {
    "name": "STEMM Lab",
    "slug": "stemm-lab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stemmlab",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.stemmlab.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Used to measure sound levels for the Sound Pollution Hunter activity.",
        "NSLocationWhenInUseUsageDescription": "Used to tag your STEMM activities with your current location.",
        "NSLocationAlwaysUsageDescription": "Used to tag your STEMM activities with your current location.",
        "NSMotionUsageDescription": "Used to detect movement and breathing patterns during STEMM activities."
      }
    },
    "android": {
      "package": "com.stemmlab.app",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-av",
      "expo-sqlite",
      "expo-background-task",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Used to tag your STEMM activities with your current location.",
          "locationWhenInUsePermission": "Used to tag your STEMM activities with your current location.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Used to detect movement and breathing patterns during STEMM activities."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a4ec1f94-e5e6-4d7e-aa67-32ed3441cfe8"
      }
    }
  }
}
